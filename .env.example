# === Application ===
APP_NAME=Credit Risk Intelligence Platform
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# === Security ===
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-in-production-use-a-real-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# === Database ===
POSTGRES_USER=credit_risk
POSTGRES_PASSWORD=change-me
POSTGRES_DB=credit_risk_platform
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://credit_risk:change-me@localhost:5432/credit_risk_platform

# === Cache / Redis ===
# Leave unset to use the in-process in-memory cache (correct for local dev,
# tests, and a single-replica deployment). Set this to enable a shared,
# multi-replica-safe cache -- the `redis` service in docker-compose.yml
# listens at redis://redis:6379/0 from inside the compose network.
REDIS_URL=
CACHE_KEY_PREFIX=credit-risk:

# === MLflow ===
MLFLOW_TRACKING_URI=./mlruns
MLFLOW_EXPERIMENT_NAME=credit-risk-v2
MLFLOW_REGISTRY_MODEL_NAME=credit_risk_champion

# === API ===
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:8501","http://localhost:3000"]
RATE_LIMIT_PER_MINUTE=60

# === Model ===
MODEL_ARTIFACT_DIR=./models/artifacts
DECISION_THRESHOLD=0.5
